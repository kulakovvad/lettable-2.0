# Copy to .env and fill in. Never commit .env.

# Grok (xAI)
XAI_API_KEY=
GROK_MODEL=grok-4.6

# V7 Go
V7_API_KEY=
V7_WORKSPACE_ID=
V7_PROJECT_ID=

# Postgres (Supabase or local Docker)
DATABASE_URL=postgresql://tracelease:tracelease@localhost:5432/tracelease

# MSCI RCA via Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_RCA_TABLE=

# Companies House
CH_API_KEY=

# MCP server (header X-API-Key)
MCP_API_KEY=

# Valuation date, ISO yyyy-mm-dd
VALUATION_DATE=2026-11-12
